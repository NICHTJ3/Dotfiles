term = xterm-256color
window-padding-balance = true
shell-integration-features = no-cursor,sudo,no-title

# Font
font-size = 15
font-thicken = true
font-thicken-strength = 50
font-family = "Maple Mono Normal"
font-family = "MesloLGS NF"
font-variation-bold = wght=500

alpha-blending = native
adjust-underline-position=2

# Styling
cursor-style = block
bold-is-bright = true
macos-titlebar-style = transparent
theme = "Rose Pine"

# Make Option key send alt escape sequences (enables option+backspace word delete, option+arrows, etc.)
macos-option-as-alt = true

# Herdr + tmux keymaps (prefix is Ctrl+a)
# New tab: Cmd+t → Ctrl+a+c
keybind = super+t=text:\x01\x63

# Close pane: Cmd+w → Ctrl+a+x
keybind = super+w=text:\x01\x78

# Next tab: Cmd+n → Ctrl+a+n
keybind = super+n=text:\x01\x6e

# Previous tab: Cmd+p → Ctrl+a+p
keybind = super+p=text:\x01\x70

# Split horizontal: Cmd+' → Ctrl+a+" (herdr: prefix+", tmux: prefix+")
keybind = super+'=text:\x01\x22

# Split vertical: Cmd+backslash → Ctrl+a+% (herdr: prefix+%, tmux: prefix+%)
keybind = super+backslash=text:\x01\x25
